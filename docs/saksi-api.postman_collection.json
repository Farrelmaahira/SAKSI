        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    if (data.token) {",
                  "        pm.collectionVariables.set(\"authToken\", data.token);",
                  "        console.log(\"Saved authToken to collection variables\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"kades.sukamaju@desa.id\",\n  \"password\": \"passwordKades123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login pengguna. Token otomatis disimpan ke variabel koleksi `authToken` untuk request terproteksi berikutnya."
          },
          "response": []
        },
        {
          "name": "Get Authenticated User (Me)",
          "request": {
            "auth": {
              "type": "bearer",
