# Lokal: .venv/bin/uvicorn app.main:app --port 8000 --env-file .env  (docker compose membaca file ini otomatis)
# Harus sama dengan AI_API_KEY di backend
AI_API_KEY=ganti-dengan-kunci-acak
GROQ_API_KEY=
GEMINI_API_KEY=
# Urutan penyedia yang dicoba; penyedia tanpa API key dilewati
AI_PROVIDERS=groq,gemini
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# AI_PROVIDER_TIMEOUT=6
