# Salin ke .env (tidak ikut git). docker compose membaca file ini otomatis; tanpa Docker:
#   .venv/bin/uvicorn app.main:app --port 8000 --env-file .env
# Referensi lengkap: docs/ai-engine.md

# Harus sama dengan AI_API_KEY di backend (kunci untuk gRPC x-api-key dan header X-API-Key REST).
AI_API_KEY=ganti-dengan-kunci-acak
GROQ_API_KEY=
GEMINI_API_KEY=

# Rantai fallback, dicoba berurutan: "provider:model" dipisah koma. Model yang kena limit (429), overload (503),
# timeout, atau jawabannya tidak valid dilewati; penyedia tanpa API key juga dilewati.
# Entri tanpa ":model" (format lama, mis. "groq,gemini") memakai GROQ_MODEL / GEMINI_MODEL di bawah.
AI_PROVIDERS=gemini:gemini-3-flash-preview,groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash
# GROQ_MODEL=qwen/qwen3.8-27b
# GEMINI_MODEL=gemini-3-flash-preview

# Batas satu percobaan ke satu model, detik (total, termasuk jawaban yang menetes).
# AI_PROVIDER_TIMEOUT=6

# Port gRPC (lokal 50051; di Azure App Service 8585). 0 = gRPC mati, REST /v1/audit tetap jalan.
# GRPC_PORT=50051
