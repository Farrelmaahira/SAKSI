PORT=8080
SAKSI_SECRET=saksi-development-secret-key-min16chars
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saksi?sslmode=disable
STORAGE_DIR=./data/files
AI_ENGINE_URL=http://localhost:8000
AI_API_KEY=dev-internal-key-saksi
WEB_ORIGIN=http://localhost:3000
# gRPC ke ai-engine (utama). TLS otomatis untuk port 443 atau https://; paksa dengan AI_ENGINE_GRPC_TLS=true.
AI_ENGINE_GRPC_ADDR=localhost:50051
AI_ENGINE_GRPC_TLS=false
# Kosong = cache mati; rate limit tetap jalan in-memory per instance. Mendukung redis:// dan rediss://.
REDIS_URL=
# IP/CIDR proxy tepercaya (koma). Hanya dari sini X-Forwarded-For dibaca.
TRUSTED_PROXIES=
# development/local/test = token reset sandi dikembalikan di respons + log (belum ada layanan email). Kosong/production = tidak.
APP_ENV=development
